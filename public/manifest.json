{
  "manifest_version": 3,
  "name": "X 头像快捷关注（0.3.6 预览版）",
  "version": "0.3.6",
  "description": "核实蓝 V 与关注关系后显示快捷入口；支持群聊资料页操作、关系面板和 Enter 发送。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "XPremium-Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
